const e = s("-@6 oh hh oh hh -@2 oh hh oh hh").bank("RolandTR909").decay(0.05).room(0.4)


const semi_base = stack(
  note("- - - - 31@2 31@2".add(0)).sound("supersaw").lpf(500).attack(0.1).decay(0.4),
  note("31@4 -@2 -@2 ").sound("supersaw").lpf(500).attack(0.1).decay(1).release(0.5)
